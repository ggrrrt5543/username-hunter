# Точная проверка через Telegram API (очень рекомендуется!)
# Получить: https://my.telegram.org -> API development tools
API_ID=
API_HASH=
# Параллельных запросов к сайтам (8 — оптимально, выше — риск бана по IP)
CONCURRENCY=auto
# Если Telegram не подключается (блокировки) — прокси:
# PROXY=socks5://127.0.0.1:1080
# PROXY=mtproxy://SECRET@host:443
PROXY=
